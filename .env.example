# Firebase Configuration
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-auth-domain"
VITE_FIREBASE_FIRESTORE_DB_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET="your-storage-bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Web Push (FCM). Get this from Firebase Console > Project settings > Cloud Messaging >
# Web Push certificates > "Key pair". Without it, push registration is skipped gracefully.
VITE_FIREBASE_VAPID_KEY="your-web-push-vapid-public-key"

# TMDB Configuration
VITE_TMDB_API_KEY="your-tmdb-api-key"

# Optional: route TMDB calls through the Cloud Function proxy so the key isn't shipped in the
# client bundle. Set to the deployed `tmdb` function URL, e.g.
# https://europe-west1-cinepair-31543.cloudfunctions.net/tmdb  (leave empty to call TMDB directly).
VITE_TMDB_PROXY_URL=""
