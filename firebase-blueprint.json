{
  "entities": {
    "Movie": {
      "title": "Movie",
      "description": "A movie available for swiping",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "year": { "type": "string" },
        "rating": { "type": "number" },
        "posterUrl": { "type": "string" },
        "synopsis": { "type": "string" },
        "genres": { "type": "array", "items": { "type": "string" } },
        "duration": { "type": "string" }
      },
      "required": ["id", "title", "posterUrl"]
    },
    "Swipe": {
      "title": "Swipe",
      "description": "A user's swipe on a movie",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "movieId": { "type": "string" },
        "type": { "type": "string", "enum": ["like", "dislike"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "movieId", "type", "timestamp"]
    },
    "Match": {
      "title": "Match",
      "description": "A shared match between two users",
      "type": "object",
      "properties": {
        "movieId": { "type": "string" },
        "userIds": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["movieId", "userIds", "timestamp"]
    },
    "User": {
      "title": "User",
      "description": "App user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "partnerId": { "type": "string" }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/movies/{movieId}": {
      "schema": "Movie",
      "description": "Global movie database"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/swipes/{swipeId}": {
      "schema": "Swipe",
      "description": "User's individual swipes"
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Shared matches between partners"
    }
  }
}
