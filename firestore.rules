rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin status must NOT be derived from a client-writable field.
    // It is gated solely on a verified custom auth claim / hard-coded owner email.
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true ||
          (request.auth.token.email == "pr.nemes@gmail.com" && request.auth.token.email_verified == true));
    }

    // True if the CURRENT user has `targetId` in their own partnerIds array.
    function readerLinkedTo(targetId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('partnerIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        (targetId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerIds);
    }

    // ===============================================================
    // Data Validation
    // ===============================================================
    function isValidUser(data) {
      // Strict key allow-list: blocks privilege-escalation fields like `role`.
      return data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'partnerId', 'partnerIds', 'email', 'createdAt', 'activeCollectionId']) &&
             data.keys().hasAll(['uid']) &&
             data.uid is string && data.uid.size() > 0 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 500)) &&
             (!('email' in data) || (data.email is string && data.email.size() < 320)) &&
             (!('createdAt' in data) || (data.createdAt is string)) &&
             (!('partnerIds' in data) || (data.partnerIds is list)) &&
             (!('partnerId' in data) || (data.partnerId is string)) &&
             (!('activeCollectionId' in data) || (data.activeCollectionId is string));
    }

    function isValidInvite(data) {
      return data.keys().hasOnly(['from', 'to', 'fromName', 'fromPhoto', 'status', 'createdAt', 'collectionId', 'collectionName']) &&
             data.keys().hasAll(['from', 'to', 'status']) &&
             data.from == request.auth.uid &&
             data.to is string && data.to.size() > 0 && data.to != request.auth.uid &&
             data.status == 'pending' &&
             (!('fromName' in data) || data.fromName is string) &&
             (!('fromPhoto' in data) || data.fromPhoto is string) &&
             (!('collectionId' in data) || data.collectionId is string) &&
             (!('collectionName' in data) || data.collectionName is string);
    }

    function isValidCollection(data) {
      return data.keys().hasOnly(['name', 'ownerId', 'memberIds', 'createdAt']) &&
             data.keys().hasAll(['name', 'ownerId', 'memberIds']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 60 &&
             data.ownerId is string &&
             data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 30;
    }

    // A non-owner may only add or remove THEIR OWN uid to/from memberIds — nothing else.
    function onlyTogglesSelfInCollection() {
      return isAuthenticated() &&
             'memberIds' in resource.data &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
             request.resource.data.memberIds is list &&
             request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).hasOnly([request.auth.uid]) &&
             resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).hasOnly([request.auth.uid]);
    }

    function isValidSwipe(data) {
      return data.keys().hasOnly(['userId', 'movieId', 'type', 'timestamp']) &&
             data.keys().hasAll(['userId', 'movieId', 'type', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.movieId is string &&
             data.type in ['like', 'dislike'] &&
             data.timestamp is timestamp;
    }

    // The other participant in a 2-person match (relative to the caller).
    function matchPartnerId(userIds) {
      return userIds[0] == request.auth.uid ? userIds[1] : userIds[0];
    }

    // Allows a user to add ONLY their own uid to another user's partnerIds
    // (reciprocal pairing), without touching any other field or removing entries.
    function onlyAddsSelfToPartners() {
      return isAuthenticated() &&
             'partnerIds' in resource.data &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerIds']) &&
             request.resource.data.partnerIds is list &&
             request.resource.data.partnerIds.toSet().difference(resource.data.partnerIds.toSet()).hasOnly([request.auth.uid]) &&
             resource.data.partnerIds.toSet().difference(request.resource.data.partnerIds.toSet()).size() == 0;
    }

    // A like swipe by `uid` on `movieId` must actually exist.
    function hasLiked(uid, movieId) {
      return exists(/databases/$(database)/documents/users/$(uid)/swipes/$(movieId)) &&
             get(/databases/$(database)/documents/users/$(uid)/swipes/$(movieId)).data.type == 'like';
    }

    function isValidMatch(data) {
      return data.keys().hasOnly(['movieId', 'userIds', 'matchedBy', 'timestamp', 'watched']) &&
             data.keys().hasAll(['movieId', 'userIds', 'matchedBy', 'timestamp']) &&
             data.movieId is string &&
             data.userIds is list &&
             data.userIds.size() == 2 &&
             request.auth.uid in data.userIds &&
             data.matchedBy == request.auth.uid &&
             data.timestamp is timestamp &&
             // Both sides must genuinely have liked the movie — no forging matches onto victims.
             hasLiked(request.auth.uid, data.movieId) &&
             hasLiked(matchPartnerId(data.userIds), data.movieId);
    }

    // ===============================================================
    // Match Rules
    // ===============================================================

    match /movies/{movieId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Only the owner and members the owner has linked may read a profile (PII: email).
      allow read: if isOwner(userId) || readerLinkedTo(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      // Owner can edit their own doc; anyone else may only append their own uid (reciprocal pairing).
      allow update: if (isOwner(userId) && isValidUser(request.resource.data)) || onlyAddsSelfToPartners();
    }

    // FCM device tokens for push — strictly owner-only (a Cloud Function reads them via admin).
    match /users/{userId}/fcmTokens/{token} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/swipes/{swipeId} {
      // A reader may see a partner's swipes only if the partner is in the reader's partnerIds.
      allow read: if isOwner(userId) || readerLinkedTo(userId);
      allow create: if isOwner(userId) && isValidSwipe(request.resource.data);
      allow update, delete: if isOwner(userId);
    }

    // Consent-based pairing: an invite grants NO access; only its acceptance links both users.
    match /invites/{inviteId} {
      allow read: if isAuthenticated() &&
                     (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isAuthenticated() && isValidInvite(request.resource.data);
      // Only the recipient may accept/decline, and only by changing `status`.
      allow update: if isAuthenticated() && resource.data.to == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                       request.resource.data.status in ['accepted', 'declined'];
      allow delete: if isAuthenticated() &&
                       (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Named collections (groups). Matches are DERIVED client-side as the intersection of members'
    // likes, so there is no match document here — just membership.
    match /collections/{cid} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuthenticated() && isValidCollection(request.resource.data) &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.auth.uid in request.resource.data.memberIds;
      // Owner: any valid edit (ownerId immutable). Non-owner: may only join/leave (toggle own uid).
      allow update: if isAuthenticated() && (
                       (resource.data.ownerId == request.auth.uid &&
                         isValidCollection(request.resource.data) &&
                         request.resource.data.ownerId == resource.data.ownerId)
                       || onlyTogglesSelfInCollection()
                     );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Per-collection "watched" flags, editable by any member.
      match /watched/{movieId} {
        allow read, write: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/collections/$(cid)).data.memberIds;
      }
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated() && isValidMatch(request.resource.data);
      // Members may only flip `watched`; membership/movie/initiator are immutable.
      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.userIds &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['watched']);
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.userIds;
    }
  }
}
